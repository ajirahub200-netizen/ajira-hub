{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "ajira-hub",

  "main": "./_worker.js",

  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",

    "run_worker_first": [
      "/job",
      "/job/*"
    ]
  }
}